        <name>Register Attendee</name>
        <onclick>registerAttendee()</onclick>
        <order>100</order>
        <script><![CDATA[function registerAttendee() {
    var firstName = prompt("Enter Attendee First Name:");
    var lastName = prompt("Enter Attendee Last Name:");
    var email = prompt("Enter Attendee Email:");
    var contactNumber = prompt("Enter Contact Number:");

    if (firstName && lastName && email && contactNumber) {
        var ga = new GlideAjax('AttendeeUtilsClient');
        ga.addParam('sysparm_name', 'createAttendee');
        ga.addParam('sysparm_eventId', g_form.getUniqueValue());
        ga.addParam('sysparm_firstName', firstName);
        ga.addParam('sysparm_lastName', lastName);
        ga.addParam('sysparm_email', email);
        ga.addParam('sysparm_contactNumber', contactNumber);

        ga.getXMLAnswer(function(response) {
            if (response.trim() === 'success') {
                alert('Attendee registered successfully.');
            } else {
                alert('Failed to register attendee.');
            }
        });
    } else {
        alert("All fields are required.");
    }
}
]]></script>
