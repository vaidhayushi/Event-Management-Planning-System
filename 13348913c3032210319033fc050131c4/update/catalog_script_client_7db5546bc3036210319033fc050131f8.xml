        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading) {
   if (isLoading || newValue == '') {
      return;
   }
function fetchAttendee(attendeeId) {
    var ga = new GlideAjax('AttendeeUtilsClient');
    ga.addParam('sysparm_name', 'getAttendeeDetailsById');
    ga.addParam('sysparm_attendee_id', attendeeId);
    ga.getXMLAnswer(function(response) {
        var data = JSON.parse(response);

        if (data.error) {
            alert(data.error);
        } else {
            alert(
                "Name: " + data.first_name + " " + data.last_name +
                "\nEmail: " + data.email +
                "\nContact: " + data.contact_number +
                "\nEvent: " + data.event_id
            );
        }
    });
}

 
}

