        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    var comments = current.u_comments.toLowerCase();

    if (comments.includes('excellent')) {
        current.u_rating = 'Excellent';
    } else if (comments.includes('good')) {
        current.u_rating = 'Good';
    } else if (comments.includes('average')) {
        current.u_rating = 'Average';
    } else if (comments.includes('poor')) {
        current.u_rating = 'Poor';
