        <name>Reschedule</name>
        <onclick>rescheduleEvent()</onclick>
        <order>100</order>
        <script><![CDATA[function rescheduleEvent() {
    var newDate = prompt("Enter New Event Date (YYYY-MM-DD):");
    if (newDate) {
        var ga = new GlideAjax('EventUtilsClient');
        ga.addParam('sysparm_name', 'rescheduleEvent');
        ga.addParam('sysparm_eventId', g_form.getUniqueValue());
        ga.addParam('sysparm_newDate', newDate);

        ga.getXMLAnswer(function(response) {
            g_form.log('Response from server: ' + response);
            if (response.trim() == 'success') {
                alert('Event rescheduled successfully.');
                g_form.setValue('u_event_date', newDate);
                g_form.save();
            } else {
                alert('Failed to reschedule the event.');
            }
        });
    }
}
]]></script>
