        <name>Approve Budget</name>
        <onclick>approveBudget()</onclick>
        <order>100</order>
        <script><![CDATA[function approveBudget() {
    var confirmation = confirm("Are you sure you want to Approve this Budget?");
    if (confirmation) {
        var ga = new GlideAjax('BudgetUtilsClient');
        ga.addParam('sysparm_name', 'approveBudget');
        ga.addParam('sysparm_budgetId', g_form.getUniqueValue());

        ga.getXMLAnswer(function(response) {
            if (response.trim() == 'success') {
                alert('Budget has been approved.');

                // Update Client-side field — Use correct field name
                g_form.setValue('u_status', 'approved'); // or 'status' based on actual column
                g_form.save();
            } else {
                alert('Failed to approve the budget.');
            }
        });
    }
}]]></script>
