        <script><![CDATA[function onSubmit() {
    var contact = g_form.getValue('u_contact_number').trim();

    // Remove all internal spaces and hyphens for validation
    var sanitized = contact.replace(/[\s\-]/g, '');

    // Regex to match optional +91 or 0 followed by 10-digit number starting with 6-9
    var regex = /^(?:\+91|0)?[6-9]\d{9}$/;

    if (!regex.test(sanitized)) {
        alert("Please enter a valid 10-digit Indian mobile number (with optional +91 or 0).");
        return false;
    }

    return true;
}
]]></script>
